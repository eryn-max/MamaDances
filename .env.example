# Copy names only. Real values go in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Never paste them in chat.

# Stripe (Eryn's account). Test keys for Preview, live keys for Production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=          # restricted key rk_... (see docs/SETUP.md for permissions)
STRIPE_WEBHOOK_SECRET=      # whsec_... from the webhook endpoint

# Orders and applications (Neon Postgres via Vercel Marketplace). Run db/schema.sql once.
DATABASE_URL=

# Tell Eryn about new orders (pick one or both)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_WEBHOOK_URL=

# Later: automatic Kajabi access (activation URL or Zapier hook). Empty = skipped.
KAJABI_GRANT_URL=

# Meta pixel (optional)
META_PIXEL_ID=
